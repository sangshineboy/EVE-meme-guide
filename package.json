{
  "name": "eve-meme-guide",
  "private": true,
  "type": "module",
  "description": "EVE 梗指南 — EVE Online 中文社区梗、黑话与名场面词条库（静态站）",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/run-tests.mjs",
    "prebuild": "npm run doctor",
    "find": "node scripts/find-meme.mjs",
    "new": "node scripts/new-meme.mjs",
    "check": "node scripts/validate-memes.mjs",
    "clean": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\"",
    "gen:lexicon": "node tools/gen-lexicon.mjs",
    "gen:pending": "node tools/gen-pending.mjs",
    "gen:docs": "npm run gen:lexicon && npm run gen:pending",
    "build": "npm run check && eleventy && pagefind --site _site",
    "serve": "npm run build && eleventy --serve"
  },
  "engines": {
    "node": ">=20.11.0 <21 || >=21.2.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2"
  }
}
